# Required
TELEGRAM_BOT_TOKEN=        # From @BotFather
TELEGRAM_USER_ID=          # Your numeric Telegram user ID

GROQ_API_KEY=              # From console.groq.com

# Optional
# GROQ_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b,llama-3.1-8b-instant,openai/gpt-oss-20b
# DB_PATH=data/mevabot.db    # Path to SQLite database file
# LOG_LEVEL=info            # debug | info | warn | error  (default: info in production)
# NODE_ENV=production
# Optional Plugin Toggles (comma-separated):
# DISABLED_PLUGINS=proposal         # disable specific plugins without touching code
# ENABLED_PLUGINS=remind,status     # or specify an explicit whitelist

# Optional Proposal Configuration:
# DEVELOPER_NAME="Your Name"
# PROPOSAL_PROFILE=Name: John Doe... # Optional custom bio for /proposal
